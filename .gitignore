# Build output
bin/
obj/

# Visual Studio / Rider
.vs/
.idea/
*.user

# Secrets & environment-specific config
appsettings.*.Local.json
secrets.json
*.secrets

# NLog runtime output
logs/
*.log
internal-nlog*.txt

# Docker build artifact — the React build is copied here only inside the image (or if you
# build the client yourself locally). The directory must still physically exist for
# `dotnet run`'s static web assets tooling even when empty — without it, local dev crashes
# at startup with DirectoryNotFoundException — so .gitkeep keeps the folder present while
# its real contents (built JS/CSS) stay untracked.
Carpool.API/wwwroot/*
!Carpool.API/wwwroot/.gitkeep

# OS
Thumbs.db
.DS_Store

# Assignment brief / reference material (kept locally, not submitted)
*.pdf
image (4).png
